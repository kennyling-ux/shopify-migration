# Migration workspace settings. Never commit this file (init.mjs adds it to .gitignore).

# Store: the myshopify domain, e.g. my-store.myshopify.com
SHOP=

# API access (references/setup.md → "Get API access"). Preferred: a Dev Dashboard app installed on
# the store, using the client credentials grant. Or paste an Admin API access token instead.
CLIENT_ID=
CLIENT_SECRET=
ADMIN_TOKEN=
API_VERSION=2026-10

# Source data
CURRENCY=USD            # store currency, ISO code (MYR, SGD, USD …)
SOURCE_TZ=+00:00        # timezone of dates in the exports, e.g. +08:00 for Malaysia/Singapore
DATE_ORDER=DMY          # DMY or MDY for dates like 04/03/2025
DEFAULT_COUNTRY=        # ISO country for local phone numbers and addresses, e.g. MY
WEIGHT_UNIT=KILOGRAMS   # when the weight column has no unit: KILOGRAMS GRAMS POUNDS OUNCES
DEFAULT_VENDOR=         # brand name for products without one
DEFAULT_BLOG=News       # blog that imported posts go into
DEFAULT_AUTHOR=         # author name for imported posts without one

# Labels on imported records
MIGRATION_TAG=migrated  # tag on imported customers and orders
ORDER_PREFIX=M          # imported orders are named #M1001 … so they never clash with new ones
